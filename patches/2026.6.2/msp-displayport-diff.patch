+#define MSP_OSD_MAX_STRING_LENGTH 30 // FIXME move this
+
+static uint8_t mspAttribute(uint8_t attr)
+{
+    uint8_t mspAttr = displayPortProfileMsp()->fontSelection[attr & (DISPLAYPORT_SEVERITY_COUNT - 1)] & DISPLAYPORT_MSP_ATTR_FONT;
+
+    if (attr & DISPLAYPORT_BLINK) {
+        mspAttr |= DISPLAYPORT_MSP_ATTR_BLINK;
+    }
+
+    return mspAttr;
+}
+
+static int sendString(displayPort_t *displayPort, uint8_t col, uint8_t row, uint8_t mspAttr, const uint8_t *chars, int len)
+{
+    uint8_t buf[MSP_OSD_MAX_STRING_LENGTH + 4];
+
+    if (len > MSP_OSD_MAX_STRING_LENGTH) {
+        len = MSP_OSD_MAX_STRING_LENGTH;
+    }
+
+    buf[0] = MSP_DP_WRITE_STRING;
+    buf[1] = row;
+    buf[2] = col;
+    buf[3] = mspAttr;
+
+    memcpy(&buf[4], chars, len);
+
+    return output(displayPort, MSP_DISPLAYPORT, buf, len + 4);
+}
+
+static int screenSize(const displayPort_t *displayPort)
+{
+    return displayPort->rows * displayPort->cols;
+}
+
+#ifdef USE_MSP_DISPLAYPORT_DIFF
+// Some MSP DisplayPort devices act on CLEAR_SCREEN when it arrives rather than at DRAW_SCREEN, so the
+// OSD's clear-and-redraw on every frame blanks them every frame, and text written just after the clear
+// can be wiped before it is seen (FETtec's G0 analog OSD). Here the FC keeps the screen it wants and the
+// screen it has sent, and sends only the characters that changed, writing spaces where text went away.
+// CLEAR_SCREEN goes out only to resync: at start-up, after a release, and on a redraw. One row is sent
+// again in full on every frame, so the device catches up by itself after a lost string or its own reset.
+
+#ifdef USE_OSD_HD
+#define DIFF_ROWS 31    // osd_canvas_height maximum
+#define DIFF_COLS 63    // osd_canvas_width maximum
+#else
+#define DIFF_ROWS VIDEO_LINES_PAL
+#define DIFF_COLS OSD_SD_COLS
+#endif
+#define DIFF_MAX_STALLS 200
+
+static uint8_t wantChar[DIFF_ROWS][DIFF_COLS];
+static uint8_t wantAttr[DIFF_ROWS][DIFF_COLS];
+static uint8_t sentChar[DIFF_ROWS][DIFF_COLS];
+static uint8_t sentAttr[DIFF_ROWS][DIFF_COLS];
+static bool resyncPending = true;
+static uint8_t flushRow;
+static uint8_t refreshRow;
+static uint16_t flushStalls;
+
+static int diffRows(const displayPort_t *displayPort)
+{
+    return MIN(displayPort->rows, DIFF_ROWS);
+}
+
+static int diffCols(const displayPort_t *displayPort)
+{
+    return MIN(displayPort->cols, DIFF_COLS);
+}
+
+// The serial buffer is full: try again on the next call, but give up on a port that never drains.
+static bool flushStalled(void)
+{
+    if (++flushStalls < DIFF_MAX_STALLS) {
+        return true;
+    }
+
+    flushStalls = 0;
+    resyncPending = true;
+
+    return false;
+}
+
+// Sends what changed since the last flush. Returns true while more is left because the serial buffer
+// filled up; the next call carries on from there.
+static bool flushChanges(displayPort_t *displayPort)
+{
+    if (displayPortSerial == SERIAL_PORT_NONE) {
+        return false;
+    }
+
+    if (resyncPending) {
+        uint8_t subcmd[] = { MSP_DP_CLEAR_SCREEN };
+
+        if (output(displayPort, MSP_DISPLAYPORT, subcmd, sizeof(subcmd)) <= 0) {
+            return flushStalled();
+        }
+
+        memset(sentChar, ' ', sizeof(sentChar));
+        memset(sentAttr, 0, sizeof(sentAttr));
+        resyncPending = false;
+        flushRow = 0;
+    }
+
+    const int rows = diffRows(displayPort);
+    const int cols = diffCols(displayPort);
+
+    for (; flushRow < rows; flushRow++) {
+        const int row = flushRow;
+        int col = 0;
+
+        while (col < cols) {
+            if (wantChar[row][col] == sentChar[row][col] && wantAttr[row][col] == sentAttr[row][col]) {
+                col++;
+                continue;
+            }
+
+            // One string per run of cells with the same attribute, ending at the run's last changed cell.
+            const int start = col;
+            const uint8_t attr = wantAttr[row][col];
+            int end = col;
+
+            for (int i = col; i < cols && i - start < MSP_OSD_MAX_STRING_LENGTH && wantAttr[row][i] == attr; i++) {
+                if (wantChar[row][i] != sentChar[row][i] || wantAttr[row][i] != sentAttr[row][i]) {
+                    end = i;
+                }
+            }
+
+            const int len = end - start + 1;
+
+            if (sendString(displayPort, start, row, attr, &wantChar[row][start], len) <= 0) {
+                return flushStalled();
+            }
+
+            flushStalls = 0;
+            memcpy(&sentChar[row][start], &wantChar[row][start], len);
+            memset(&sentAttr[row][start], attr, len);
+            col = end + 1;
+        }
+    }
+
+    flushRow = 0;
+
+    return false;
+}
+
 static int release(displayPort_t *displayPort)
 {
     uint8_t subcmd[] = { MSP_DP_RELEASE };
 
+    // The device may show its own screen after a release, so start from a clear screen next time.
+    resyncPending = true;
+
     return output(displayPort, MSP_DISPLAYPORT, subcmd, sizeof(subcmd));
 }
 
